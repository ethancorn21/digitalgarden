# vault-pull: bring the dev box's vault mirror up to date from Obsidian Sync (Obsidian Headless, `ob`, pinned in
# ~/opt/obsidian-headless). The mirror is mirror-remote: it only downloads and reverts any change made here, so nothing
# on the dev box can write back into the vault. One pull at a time; garden-upload waits for it.
[Unit]
Description=Obsidian Sync: pull the vault mirror
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/opt/obsidian-headless/node_modules/.bin/ob sync --path %h/vault/Me
TimeoutStartSec=30min
Nice=10
